; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Meme Thieves 3D"
config/description="دزد میم‌ها ۳بعدی — نسخه‌ی Godot"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

S="*res://scripts/core/settings.gd"
Sound="*res://scripts/core/sound.gd"
FX="*res://scripts/gfx/fx.gd"
Phys="*res://scripts/world/phys.gd"
Nav="*res://scripts/world/nav.gd"
Chars="*res://scripts/chars/templates.gd"
World="*res://scripts/world/world.gd"
Game="*res://scripts/game/game.gd"
UI="*res://scripts/ui/ui.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[internationalization]

locale/fallback="fa"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.804, 0.933, 1, 1)
renderer/rendering_method.mobile="gl_compatibility"
