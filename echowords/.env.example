# Public values from Supabase → Project Settings → API.
# The anon key is designed to be public; all data is protected by Row Level Security.
# NEVER put the service_role key or any speech-to-text API key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
